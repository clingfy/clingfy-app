/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDI_APP_ICON            ICON                    "resources\\app_icon.ico"


/////////////////////////////////////////////////////////////////////////////
//
// Version
//

#if defined(FLUTTER_VERSION_MAJOR) && defined(FLUTTER_VERSION_MINOR) && defined(FLUTTER_VERSION_PATCH) && defined(FLUTTER_VERSION_BUILD)
#define VERSION_AS_NUMBER FLUTTER_VERSION_MAJOR,FLUTTER_VERSION_MINOR,FLUTTER_VERSION_PATCH,FLUTTER_VERSION_BUILD
#else
#define VERSION_AS_NUMBER 1,0,0,0
#endif

#if defined(FLUTTER_VERSION)
#define VERSION_AS_STRING FLUTTER_VERSION
#else
#define VERSION_AS_STRING "1.0.0"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VERSION_AS_NUMBER
 PRODUCTVERSION VERSION_AS_NUMBER
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904e4"
        BEGIN
            // CompanyName is the PARENT of the settings store
            // (%APPDATA%\<CompanyName>\<ProductName>). Unlike ProductName
            // below it cannot even be re-cased usefully, and changing the
            // name would move the parent and orphan BOTH channels at once.
            // Left exactly as shipped.
            VALUE "CompanyName", "com.clingfy" "\0"
            // FileDescription is what Task Manager shows in its Name column,
            // so it is display text, not identity — safe to capitalise, and
            // worth forking per channel now that side-by-side installs are
            // supported (D9). ProductName below is identity, and the rules
            // for changing it are spelled out there.
#ifdef CLINGFY_CHANNEL_DEV
            VALUE "FileDescription", "Clingfy Dev" "\0"
#else
            VALUE "FileDescription", "Clingfy" "\0"
#endif
            VALUE "FileVersion", VERSION_AS_STRING "\0"
            // InternalName stays lowercase: it is a build-identity string
            // rather than display text, and nothing user-facing reads it.
            VALUE "InternalName", "clingfy" "\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 Clingfy. All rights reserved." "\0"
            VALUE "OriginalFilename", "clingfy.exe" "\0"
            // ProductName IS the settings store: path_provider builds
            // %APPDATA%\<CompanyName>\<ProductName>. D9 forks it so dev gets
            // its own store rather than writing into prod's.
            //
            // THE RULE, now that this has been re-cased once: the prod value
            // may change CASE and nothing else. NTFS is case-insensitive, so
            // "clingfy" and "Clingfy" are the same directory -- the existing
            // store is reused, the on-disk name simply keeps whatever casing
            // it was created with. Verified on the real volume before making
            // this change: a file written via one casing reads back through
            // the other, and mkdir with new casing creates no second folder.
            //
            // Any change that is NOT case-only is a different directory, and
            // a released build would start up looking at an empty one while
            // the user's settings sit in the old path. That is silent data
            // loss on upgrade, not a rename.
            //
            // dev follows the same rule HERE: "clingfy-dev" -> "Clingfy-Dev"
            // is case-only, so the store path_provider derives from this value
            // is reused. It briefly said "Clingfy Dev", which WOULD have been a
            // real rename; the hyphen is what keeps both channels inside the
            // case-only rule, and it also keeps the name free of a space that
            // every script touching the path would have to quote.
            //
            // The case-only rule covers THIS value only. It is not a general
            // property of Windows path renames, and specifically it did not
            // hold for the sibling change made at the same time:
            // LocalAppDataFolderName (app_identity.cpp) shipped as
            // "Clingfy Dev" WITH A SPACE and became "Clingfy-Dev", which is a
            // real rename, not a case change -- NTFS case-insensitivity does
            // not bridge a space to a hyphen. That was safe only because no
            // distributed build ever carried the spaced path: it appeared in
            // #373 (2026-07-28) and the dev feed is still 1.0.6+111 from
            // roughly a week earlier, so only local dev builds created it.
            // Do not read "renames here are case-only, therefore safe" out of
            // this comment. Check the actual shipped string before assuming.
#ifdef CLINGFY_CHANNEL_DEV
            VALUE "ProductName", "Clingfy-Dev" "\0"
#else
            VALUE "ProductName", "Clingfy" "\0"
#endif
            VALUE "ProductVersion", VERSION_AS_STRING "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END

#endif    // English (United States) resources
